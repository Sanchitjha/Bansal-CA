PORT=5000
MONGODB_URI=mongodb://localhost:27017/bansal-associates
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Auth
JWT_SECRET=replace-me-with-a-long-random-string
JWT_EXPIRES_IN=1d
BCRYPT_SALT_ROUNDS=12

# Bootstrap admin (used by `npm run seed`)
SEED_ADMIN_EMAIL=admin@bansalca.local
SEED_ADMIN_PASSWORD=change-me-on-first-login
SEED_ADMIN_FIRST_NAME=Platform
SEED_ADMIN_LAST_NAME=Admin
